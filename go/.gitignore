############################################
# GO
############################################

# Compiled binaries and build output
bin/
dist/
build/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Test, coverage, profiling, and fuzzing output
coverage.out
coverage.html
*.coverprofile
*.prof
*.trace
test-results/

# Workspace and dependency output
vendor/
go.work
go.work.sum

############################################
# LOCAL / TEMPORARY FILES
############################################

*.log
*.pid
.env
.env.*
!.env.example
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig

# Keep module checksums tracked for reproducible builds.
!go.sum
